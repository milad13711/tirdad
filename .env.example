# Postgres (matches docker-compose.yml defaults for local dev)
DATABASE_URL="postgresql://tirdad:tirdad@localhost:5432/tirdad"

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# SMS / OTP provider: "mock" logs the code to the server console instead of
# sending a real SMS. Switch to "limo" once LIMO_API_KEY is set and the
# request shape in src/lib/sms/limo.ts has been verified against the LimoSMS
# developer panel (docs were unreachable programmatically while building this).
SMS_PROVIDER="mock"
LIMO_API_KEY=""
LIMO_SENDER_NUMBER=""
