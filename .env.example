# Postgres (matches docker-compose.yml defaults for local dev)
DATABASE_URL="postgresql://tirdad:tirdad@localhost:5432/tirdad"

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# SMS / OTP provider: "mock" logs the code to the server console instead of
# sending a real SMS. Switch to "limo" once LIMO_API_KEY is set and the
# request shape in src/lib/sms/limo.ts has been verified against the LimoSMS
# developer panel (docs were unreachable programmatically while building this).
SMS_PROVIDER="mock"
LIMO_API_KEY=""
LIMO_PATTERN_ID=""

# Which gateway actually processes payments: "zarinpal" or "bitpay". Only
# one is active site-wide at a time — switch by changing this and
# restarting, no code change needed. Whichever was active when an order's
# payment was requested is recorded on its Transaction row, so in-flight
# orders still verify correctly even if you flip this mid-flight.
PAYMENT_GATEWAY="zarinpal"

# Zarinpal payment gateway (https://www.zarinpal.com) — sandbox merchant id
# "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" works against sandbox.zarinpal.com
# without a real account. Leave ZARINPAL_SANDBOX unset ("") in production.
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# BitPay.ir payment gateway (https://bitpay.ir) — API key from your BitPay
# merchant panel. BitPay has no documented sandbox mode; testing happens
# against the real gateway.
BITPAY_API_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telegram bot for admin notifications (new orders/leads/tickets). Get a
# token from @BotFather and a chat id from @userinfobot (or your group's id).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Web Push (browser notifications on installed PWA) — generate a pair with:
# npx web-push generate-vapid-keys
# The public key is also read client-side, so it must be NEXT_PUBLIC_.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
