generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  // Limited system-user tier: inbox, page-analysis requests, orders,
  // marketing only — no site settings, content, or user management.
  STAFF
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum OrderItemType {
  COURSE
  TOOL_PACKAGE
  SUBSCRIPTION
  PROMPT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AiToolType {
  IMAGE
  VIDEO
  AUDIO
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadSource {
  DIRECT
  COMMENT
  BIO_LINK
  WEBSITE
}

enum LeadStage {
  NEW
  CONTACTED
  OFFERED
  CONVERTED
  LOST
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model User {
  id            String         @id @default(cuid())
  phone         String         @unique
  name          String?
  role          Role           @default(USER)
  // Only ever set for ADMIN/STAFF accounts, created from /admin/users —
  // customers always sign in via OTP and never have one. Lets system
  // users log in without depending on SMS delivery.
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  orders        Order[]
  enrollments   Enrollment[]
  generations   AiGeneration[]
  tickets       Ticket[]
  usageLogs     UsageLog[]
  lessonCompletions LessonCompletion[]
  pushSubscriptions PushSubscription[]
  promptPurchases   PromptPurchase[]
  toolPackagePurchases ToolPackagePurchase[]
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model SubscriptionPlan {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  price            Int
  period           String         @default("monthly")
  dailyRunLimit    Int?
  monthlyRunLimit  Int?
  features         Json
  createdAt        DateTime       @default(now())
  subscriptions    Subscription[]
  orders           Order[]
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([userId])
}

model Order {
  id           String        @id @default(cuid())
  userId       String
  itemType     OrderItemType
  itemLabel    String
  amount       Int
  status       OrderStatus   @default(PENDING)
  couponId     String?
  // Campaign link slug (if any) active when this order was created — lets
  // the payment callback attribute a successful payment back to the
  // campaign, see CampaignEvent.
  campaignRef  String?
  courseId     String?
  planId       String?
  aiToolId     String?
  toolPackageId String?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  course       Course?       @relation(fields: [courseId], references: [id])
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  aiTool       AiTool?       @relation(fields: [aiToolId], references: [id])
  toolPackage  ToolPackage?  @relation(fields: [toolPackageId], references: [id])
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id        String      @id @default(cuid())
  orderId   String
  gateway   String
  refId     String?
  status    OrderStatus
  paidAt    DateTime?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Course {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String?
  coverImage    String?
  durationLabel String?
  price         Int
  // Blanket discount shown to every visitor (strikethrough on `price`),
  // separate from Coupon — null = no sale. Must be less than `price`;
  // enforced in the admin API, not the DB. Effective checkout price is
  // `salePrice ?? price`, and a coupon still applies on top of it.
  salePrice     Int?
  // Hours the sale price stays active for a given visitor, counted from
  // their first view of this product (tracked by IP in
  // PriceCountdownView) — null means salePrice is a permanent blanket
  // discount with no countdown/expiry. See src/lib/pricing.ts.
  saleCountdownHours Int?
  level         String?
  published     Boolean      @default(false)
  // Days of playback access granted from the moment of purchase. Null =
  // lifetime access (no expiry). Applied to Enrollment.expiresAt when the
  // order is paid — see payments callback.
  accessDurationDays Int?
  // Added to the real enrollment count wherever it's shown publicly — for
  // students who bought the course off-site before/outside this platform,
  // so the page doesn't show "0 دانشجو" for an otherwise-established
  // course. Purely cosmetic; never affects actual access/enrollment rows.
  displayEnrollmentOffset Int @default(0)
  createdAt     DateTime     @default(now())
  lessons       Lesson[]
  enrollments   Enrollment[]
  orders        Order[]
}

model Lesson {
  id          String             @id @default(cuid())
  courseId    String
  title       String
  order       Int
  videoUrl    String?
  isFreeDemo  Boolean            @default(false)
  // Optional downloadable resource (slides, worksheet, etc.) — an internal
  // storage key ("tool-files/<uuid>.<ext>", same upload pipeline as
  // ToolPackage files), never a public URL. Gated behind enrollment, see
  // /api/lessons/[id]/download. attachmentName is the original filename,
  // shown on the download button since the key itself is a random uuid.
  attachmentUrl  String?
  attachmentName String?
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]

  @@index([courseId])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Enrollment {
  id        String    @id @default(cuid())
  userId    String
  courseId  String
  progress  Int       @default(0)
  // Copied from Course.accessDurationDays at purchase time. Null = lifetime
  // access. Once passed, playback is blocked (see getEnrollmentForLearning)
  // though the enrollment row — and the user's history — stays intact.
  // Admin can extend/revoke it from /admin/courses/[id]/students.
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// Copyable prompts shown with a before/after example image. Was "AiTool" (a
// metered AI-generation feature with a hidden prompt); repurposed into a
// public prompt gallery. price = 0 means free — promptText/usageInstructions
// are readable by anyone. price > 0 is a paid unlock (PromptPurchase): the
// API must redact promptText/usageInstructions for anyone who hasn't paid,
// see src/lib/queries/prompts.ts.
model AiTool {
  id                String         @id @default(cuid())
  name              String         @unique
  type              AiToolType
  creditCost        Int            @default(0)
  promptText        String
  // Shown only once the prompt is unlocked (free, or purchased) — how to
  // actually use it correctly in the target AI tool.
  usageInstructions String?
  // Toman. 0 = free.
  price             Int            @default(0)
  demoBeforeUrl     String?
  demoAfterUrl      String?
  tags              String[]       @default([])
  // Shows this prompt as one of the 3 landing-page highlights. The full
  // gallery at /prompts always lists every active prompt regardless.
  featured          Boolean        @default(false)
  active            Boolean        @default(true)
  // Public gallery is unauthenticated, so these are simple counters (not
  // tied to a user) bumped by /api/prompts/[id]/view and /like — the client
  // dedupes repeat views/likes per browser via localStorage rather than
  // enforcing it server-side.
  viewCount         Int            @default(0)
  likeCount         Int            @default(0)
  createdAt         DateTime       @default(now())
  generations       AiGeneration[]
  orders            Order[]
  purchases         PromptPurchase[]
}

// One row per (user, purchased premium prompt) — grants permanent access
// and is what shows up in /dashboard/prompts. Created by the payment
// callback once a PROMPT order is verified paid.
model PromptPurchase {
  id        String   @id @default(cuid())
  userId    String
  aiToolId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiTool    AiTool   @relation(fields: [aiToolId], references: [id])

  @@unique([userId, aiToolId])
}

model AiGeneration {
  id          String           @id @default(cuid())
  userId      String
  aiToolId    String
  status      GenerationStatus @default(PENDING)
  inputUrl    String?
  outputUrl   String?
  creditsUsed Int
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiTool      AiTool           @relation(fields: [aiToolId], references: [id])

  @@index([userId])
}

// Downloadable asset packs shown on the public "ابزارها" (Tools) landing
// section and /tools archive — font packs, CapCut effect presets, LUTs,
// etc. price = 0 means free (anyone can download, no purchase needed);
// price > 0 requires a ToolPackagePurchase, created by the payment
// callback once a TOOL_PACKAGE order is verified paid — mirrors how
// AiTool/PromptPurchase gates premium prompts.
model ToolPackage {
  id            String                @id @default(cuid())
  title         String
  slug          String                @unique
  category      String?
  description   String?
  coverImage    String?
  // YouTube/Vimeo link or an uploaded file served via /api/uploads — shown
  // as a demo/preview on the public tool detail page.
  demoVideoUrl  String?
  fileUrl       String?
  price         Int                   @default(0)
  // Same blanket-discount mechanism as Course.salePrice.
  salePrice     Int?
  saleCountdownHours Int?
  published     Boolean               @default(false)
  downloadCount Int                   @default(0)
  createdAt     DateTime              @default(now())
  orders        Order[]
  purchases     ToolPackagePurchase[]
}

// One row per (user, purchased paid tool package) — grants permanent
// download access, created by the payment callback. Free packages need no
// row here; download access is just "price === 0".
model ToolPackagePurchase {
  id            String      @id @default(cuid())
  userId        String
  toolPackageId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolPackage   ToolPackage @relation(fields: [toolPackageId], references: [id])

  @@unique([userId, toolPackageId])
}

model BlogPost {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?
  content         String?
  coverImage      String?
  metaTitle       String?
  metaDescription String?
  status          BlogStatus @default(DRAFT)
  views           Int        @default(0)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
}

model Lead {
  id            String     @id @default(cuid())
  name          String
  phone         String?
  source        LeadSource
  topic         String?
  message       String?
  // Instagram page-analysis requests (landing page): the page being
  // requested and a screenshot of its bio, uploaded via
  // /api/leads/upload. Both null for other lead sources.
  pageUrl       String?
  attachmentUrl String?
  // Admin's written analysis for a page-analysis request (pageUrl set) and
  // when it was sent back to the requester via SMS — see
  // /api/admin/leads/respond. Null until the admin responds.
  analysisNote  String?
  respondedAt   DateTime?
  stage         LeadStage  @default(NEW)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  subject   String
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([userId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  sender    String
  message   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountPercent Int
  usageLimit     Int?
  usedCount      Int       @default(0)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  orders         Order[]
}

// Tracks the first time a given IP viewed a product with an active
// countdown sale, so the countdown shown to that visitor keeps counting
// down consistently across page loads/devices-on-that-IP instead of
// resetting. productKey is "COURSE:<id>" or "TOOL_PACKAGE:<id>" (see
// src/lib/product-key.ts) — a single string key avoids the two-nullable-FK
// uniqueness trap in Postgres (NULL != NULL breaks a real unique
// constraint across (courseId, toolPackageId, ip)).
model PriceCountdownView {
  id          String   @id @default(cuid())
  productKey  String
  ip          String
  firstSeenAt DateTime @default(now())

  @@unique([productKey, ip])
}

// A shareable, trackable link for one product (e.g. for an ad campaign).
// Visiting /go/<slug> increments clickCount and redirects to the real
// product page, tagging the visit with this link's id for attribution.
model CampaignLink {
  id         String   @id @default(cuid())
  slug       String   @unique
  productKey String
  label      String?
  clickCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productKey])
}

// Funnel events for a product's landing page, whether or not they arrived
// via a CampaignLink (campaignLinkId is null for organic/direct traffic,
// so "page views for this product" still has a complete count).
// sessionId is a random id the client sets once per browser tab/visit.
model CampaignEvent {
  id             String   @id @default(cuid())
  productKey     String
  campaignLinkId String?
  sessionId      String
  // "page_view" | "dwell_10s" | "section_focus" | "pay_click" | "pay_success"
  type           String
  section        String?
  createdAt      DateTime @default(now())

  @@index([productKey])
  @@index([campaignLinkId])
  @@index([sessionId, type])
}

// A visitor's question asked directly from a product landing page, with
// their phone number for support follow-up — shown to admins alongside
// the campaign stats for that product.
model CampaignQuestion {
  id             String    @id @default(cuid())
  productKey     String
  campaignLinkId String?
  phone          String
  message        String
  answeredAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([productKey])
}

// System-wide audit trail — failed/successful logins, OTP sends, purchase
// requests, payment outcomes, etc. Deliberately has no required relation
// (userId/phone are both optional) since many events happen before any
// User row exists (e.g. a failed OTP for a number that never signs up) or
// have no user at all (an SMS-provider failure). Viewed at /admin/logs.
model EventLog {
  id        String   @id @default(cuid())
  action    String
  success   Boolean  @default(true)
  userId    String?
  phone     String?
  message   String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Singleton row (always id = 1) for site-wide toggles the super admin
// controls from /admin/settings — start with subscription-plan visibility,
// extend with more flags here as needed rather than adding new models.
// `content` holds free-text landing copy overrides (hero title, section
// blurbs, CTA labels) keyed by a fixed set of known keys — see
// src/lib/site-content.ts for the shape and defaults.
model SiteSettings {
  id                       Int      @id @default(1)
  subscriptionPlansEnabled Boolean  @default(false)
  content                  Json     @default("{}")
  updatedAt                DateTime @updatedAt
}

// Singleton row (always id = 1) storing the admin's LimoSMS (api.limosms.com)
// credentials. `enabled` is only set true once a save has been verified
// against the getcurrentcredit endpoint, so trigger dispatch can trust it.
model SmsSettings {
  id           Int      @id @default(1)
  apiKey       String?
  senderNumber String?
  enabled      Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

// Admin-defined SMS automations. `eventKey` matches a key from
// src/lib/sms/event-keys.ts (or a custom one) and is looked up by
// dispatchSmsTrigger() at the matching point in the app (order paid, lead
// created, ...). `message` may contain {{variable}} placeholders that get
// substituted with the values passed to dispatchSmsTrigger.
model SmsTrigger {
  id        String   @id @default(cuid())
  name      String
  eventKey  String
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventKey])
}

// Singleton row (always id = 1) storing the admin's linked Instagram
// business account credentials for the CRM sync. A real Meta Graph API
// integration also requires an approved Meta app + webhook subscription
// for live DM push; this stores what's needed to call the Graph API for a
// manual/periodic pull once that app-level setup is done outside this repo.
model InstagramConnection {
  id                Int       @id @default(1)
  accessToken       String?
  businessAccountId String?
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  lastSyncError     String?
  updatedAt         DateTime  @updatedAt
}

// One row per browser/device that opted into push notifications (from the
// installed PWA or the site itself — Notification permission doesn't
// require installing). userId is nullable: a visitor can opt in before
// logging in, and admin broadcasts target every row regardless of user.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MarketingChannel {
  PUSH
  SMS
  WHATSAPP
  TELEGRAM
  BALE
  INSTAGRAM
}

// One row per marketing send from /admin/marketing. `segments` snapshots
// the audience-filter keys (src/lib/queries/marketing.ts SEGMENTS) picked
// for that send. `clickCount` is incremented by the /api/marketing/click
// redirect route when a tracked link in the message is opened — only
// PUSH/SMS messages currently carry one.
model MarketingCampaign {
  id             String           @id @default(cuid())
  channel        MarketingChannel
  message        String
  segments       Json
  recipientCount Int
  sentCount      Int              @default(0)
  clickCount     Int              @default(0)
  createdAt      DateTime         @default(now())
}

enum MessengerProvider {
  TELEGRAM
  BALE
  WHATSAPP
  INSTAGRAM
}

// One row per messenger bot connection (singleton per provider). Telegram
// and Bale both expose a Telegram-compatible Bot API, so both are polled
// via getUpdates rather than a webhook — the production server doesn't
// have a domain/SSL yet, which Bot API webhooks require, but getUpdates
// works fine over plain outbound HTTPS from us to them.
model MessengerConnection {
  id            String            @id @default(cuid())
  provider      MessengerProvider @unique
  token         String?
  botUsername   String?
  connectedAt   DateTime?
  pollOffset    Int               @default(0)
  lastPollAt    DateTime?
  lastPollError String?
  // WhatsApp Cloud API only: Phone Number ID (Graph API target for sends)
  // and the verify token the admin chose, checked against Meta's webhook
  // handshake at src/app/api/webhooks/whatsapp/route.ts. Null for every
  // other provider.
  phoneNumberId String?
  verifyToken   String?
  updatedAt     DateTime          @updatedAt
}

enum InboxDirection {
  IN
  OUT
}

// Archived messenger conversation history, populated by the polling loop
// (src/lib/messengers/poll.ts) for inbound messages and by the admin
// reply action for outbound ones. Threads are grouped by
// (provider, externalId) — externalId is the provider's own chat id,
// needed to send a reply back.
model InboxMessage {
  id           String            @id @default(cuid())
  provider     MessengerProvider
  externalId   String
  senderName   String?
  senderHandle String?
  direction    InboxDirection
  text         String
  createdAt    DateTime          @default(now())
  // Instagram polling has no Telegram-style update offset to consume from,
  // so new messages are deduped against already-imported ones by the
  // Graph API's own message id. Telegram/Bale don't need this (their
  // pollOffset already guarantees no repeats) and leave it null.
  externalMessageId String?       @unique

  @@index([provider, externalId])
}

// Singleton row (id = 1) storing a VLESS/VMess config to eventually route
// Telegram/Instagram/WhatsApp API calls through, since those are filtered
// in Iran. Storage only for now — actually proxying traffic through it
// needs a server-side proxy process (e.g. xray-core) wired into the
// deploy pipeline, which is a separate, larger infra change not done yet.
model VpnConfig {
  id        Int      @id @default(1)
  configUrl String?
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
