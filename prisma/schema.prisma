generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum OrderItemType {
  COURSE
  PROMPT_PACKAGE
  SUBSCRIPTION
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AiToolType {
  IMAGE
  VIDEO
  AUDIO
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadSource {
  DIRECT
  COMMENT
  BIO_LINK
  WEBSITE
}

enum LeadStage {
  NEW
  CONTACTED
  OFFERED
  CONVERTED
  LOST
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model User {
  id            String         @id @default(cuid())
  phone         String         @unique
  name          String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  orders        Order[]
  enrollments   Enrollment[]
  generations   AiGeneration[]
  tickets       Ticket[]
  usageLogs     UsageLog[]
  lessonCompletions LessonCompletion[]
  serviceRequests   ServiceRequest[]
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model SubscriptionPlan {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  price            Int
  period           String         @default("monthly")
  dailyRunLimit    Int?
  monthlyRunLimit  Int?
  features         Json
  createdAt        DateTime       @default(now())
  subscriptions    Subscription[]
  orders           Order[]
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([userId])
}

model Order {
  id           String        @id @default(cuid())
  userId       String
  itemType     OrderItemType
  itemLabel    String
  amount       Int
  status       OrderStatus   @default(PENDING)
  couponId     String?
  courseId     String?
  planId       String?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  course       Course?       @relation(fields: [courseId], references: [id])
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id        String      @id @default(cuid())
  orderId   String
  gateway   String
  refId     String?
  status    OrderStatus
  paidAt    DateTime?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Course {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String?
  coverImage    String?
  durationLabel String?
  price         Int
  level         String?
  published     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  lessons       Lesson[]
  enrollments   Enrollment[]
  orders        Order[]
}

model Lesson {
  id          String             @id @default(cuid())
  courseId    String
  title       String
  order       Int
  videoUrl    String?
  isFreeDemo  Boolean            @default(false)
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]

  @@index([courseId])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// Free, copyable prompts shown with a before/after example image. Was
// "AiTool" (a metered AI-generation feature with a hidden prompt); repurposed
// into a public prompt gallery, so promptText is intentionally readable by
// any authenticated user — never treat it as a secret.
model AiTool {
  id            String         @id @default(cuid())
  name          String         @unique
  type          AiToolType
  creditCost    Int            @default(0)
  promptText    String
  demoBeforeUrl String?
  demoAfterUrl  String?
  tags          String[]       @default([])
  // Shows this prompt as one of the 3 landing-page highlights. The full
  // gallery at /prompts always lists every active prompt regardless.
  featured      Boolean        @default(false)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  generations   AiGeneration[]
}

model AiGeneration {
  id          String           @id @default(cuid())
  userId      String
  aiToolId    String
  status      GenerationStatus @default(PENDING)
  inputUrl    String?
  outputUrl   String?
  creditsUsed Int
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiTool      AiTool           @relation(fields: [aiToolId], references: [id])

  @@index([userId])
}

model PromptPackage {
  id        String   @id @default(cuid())
  title     String
  category  String?
  price     Int
  fileUrl   String?
  createdAt DateTime @default(now())
}

model BlogPost {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?
  content         String?
  coverImage      String?
  metaTitle       String?
  metaDescription String?
  status          BlogStatus @default(DRAFT)
  views           Int        @default(0)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  source    LeadSource
  topic     String?
  message   String?
  stage     LeadStage  @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  subject   String
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([userId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  sender    String
  message   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountPercent Int
  usageLimit     Int?
  usedCount      Int       @default(0)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  orders         Order[]
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Singleton row (always id = 1) for site-wide toggles the super admin
// controls from /admin/settings — start with subscription-plan visibility,
// extend with more flags here as needed rather than adding new models.
// `content` holds free-text landing copy overrides (hero title, section
// blurbs, CTA labels) keyed by a fixed set of known keys — see
// src/lib/site-content.ts for the shape and defaults.
model SiteSettings {
  id                       Int      @id @default(1)
  subscriptionPlansEnabled Boolean  @default(false)
  content                  Json     @default("{}")
  updatedAt                DateTime @updatedAt
}

// Singleton row (always id = 1) storing the admin's linked Instagram
// business account credentials for the CRM sync. A real Meta Graph API
// integration also requires an approved Meta app + webhook subscription
// for live DM push; this stores what's needed to call the Graph API for a
// manual/periodic pull once that app-level setup is done outside this repo.
model InstagramConnection {
  id                Int       @id @default(1)
  accessToken       String?
  businessAccountId String?
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  lastSyncError     String?
  updatedAt         DateTime  @updatedAt
}

enum ServiceRequestType {
  TEASER
  IMAGE
  WEBSITE
}

enum ServiceRequestStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  DONE
  CLOSED
}

model ServiceRequest {
  id          String                @id @default(cuid())
  userId      String
  type        ServiceRequestType
  description String
  status      ServiceRequestStatus  @default(NEW)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Portfolio samples of finished custom teaser/content work, shown in the
// landing page's "تولید محتوا" section — distinct from the AiTool prompt
// gallery, which showcases prompts visitors can use themselves.
model TeaserSample {
  id         String   @id @default(cuid())
  title      String
  coverImage String?
  videoUrl   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}
